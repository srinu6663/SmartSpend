# ── Supabase (required) ───────────────────────────────────────────────────────
# Dashboard → Project Settings → API
# NOTE: free-tier projects auto-pause after ~7 days of inactivity. While paused
# the *.supabase.co hostname stops resolving (ERR_NAME_NOT_RESOLVED) and every
# request fails. Resume the project from the dashboard to bring it back.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Firebase (FCM push notifications, optional) ───────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# ── Server-side only (Supabase Edge Function secrets — never VITE_ prefixed) ──
# Anything VITE_-prefixed is compiled into the browser bundle and is PUBLIC.
# Gemini is called only from the `ai` Edge Function, so its key must NOT be
# VITE_-prefixed. Set it with:  supabase secrets set GEMINI_API_KEY=...
GEMINI_API_KEY=
RESEND_API_KEY=

# ── Direct Postgres access (migrations, scripts, server jobs) ─────────────────
# Browser code talks to PostgREST over HTTPS and needs none of this.
# Transaction mode (port 6543) — pooled, for serverless/short-lived connections:
# DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-1-<region>.pooler.supabase.com:6543/postgres
# Session mode (port 5432) — one backend per client, required for migrations:
# DIRECT_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-1-<region>.pooler.supabase.com:5432/postgres
